        "translations": {
            "en": {
                "template_title": "ONOKOM AIR LG-8-MB-B (Adapter for household LG systems)",
                "Error 1": "CH01 - Indoor unit return air sensor fault",
                "Error 2": "CH02 - Indoor Pipe Sensor or Outdoor Sensor Assy fault, Open or Short",
                "Error 3": "CH03 - Remote controller comms error",
                "Error 4": "CH04 - RAC Product: Heat Sink Sensor Error / Commercial Product: Condensate pump float switch risen",
                "Error 5": "CH05 - Comms Error, check your wiring",
                "Error 6": "CH06 - Indoor unit coil sensor fault",
                "Error 7": "CH07 - Multi Splits/Multi V: indoor unit is set to run in a different mode / RAC: Indoor unit BLDC Fan problem",
                "Error 8": "CH08 - Check the fan motor turns freely / AC Voltage issue",
                "Error 9": "CH09 - Split: Outdoor unit fan problem / Multi V: indoor PCB failure",
                "Error 10": "CH10 - RAC Product: Compressor discharge sensor fault",
                "Error 11": "CH11 - Multi V indoor unit not connected to an outdoor unit",
                "Error 21": "CH21 - Inverter compressor run current high",
                "Error 22": "CH22 - Inverter compressor run current high",
                "Error 23": "CH23 - Inverter dc voltage low",
                "Error 24": "CH24 - Splits and Multi Splits = High or low pressure trip",
                "Error 25": "CH25 - Check power supply voltage to the outdoor unit is correct",
                "Error 26": "CH26 - Inverter compressor seized",
                "Error 27": "CH27 - Inverter current irregularity",
                "Error 28": "CH28 - Inverter dc voltage too high",
                "Error 32": "CH32 - Inverter compressor discharge temperature too high",
                "Error 33": "CH33 - Excessive rise of standard compressor discharge temperature",
                "Error 34": "CH34 - Excessive high pressure rise, over 35 bar at HP sensor",
                "Error 35": "CH35 - Excessive low pressure drop under 1 Bar at LP sensor",
                "Error 40": "CH40 - Inverter ac current abnormal",
                "Error 41": "CH41 - Inverter compressor discharge sensor fault",
                "Error 42": "CH42 - Low pressure sensor fault",
                "Error 43": "CH43 - High pressure sensor fault",
                "Error 44": "CH44 - Outdoor unit air sensor fault",
                "Error 45": "CH45 - Outdoor unit coil sensor fault",
                "Error 46": "CH46 - Outdoor unit suction sensor fault",
                "Error 47": "CH47 - Compressor discharge sensor fault",
                "Error 48": "CH48 - Outdoor unit discharge and air sensor both unplugged",
                "Error 49": "CH49 - Check power supply voltage to the outdoor unit is correct",
                "Error 51": "CH51 - Unit mismatch. Check model number of units",
                "Error 52": "CH52 - Communication error between inverter PCB and main outdoor unit PCB",
                "Error 54": "CH54 - Comms error indoor to outdoor unit",
                "Error 57": "CH57 - Comms error between outdoor main PCB and inverter PCB",
                "Error 60": "CH60 - Outdoor unit PCB EEPROM failure",
                "Error 61": "CH61 - Condenser coil over 65°C",
                "Error 62": "CH62 - Inverter over 85°C",
                "Error 65": "CH65 - Outdoor unit inverter fin temperature sensor fault",
                "Error 67": "CH67 - Outdoor Fan Motor seized, or rotation sensing circuit failure",
                "Error 70": "Gateway error – line is noisy"
            },
